{
  "name": "dobot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch src/server/index.ts --dev-page\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preflight": "bash scripts/preflight.sh",
    "day-one": "tsx scripts/day-one.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "@e2b/desktop": "2.4.0",
    "@hono/node-server": "2.1.1",
    "croner": "10.0.1",
    "e2b": "2.49.1",
    "hono": "4.13.7",
    "imapflow": "1.7.8",
    "nodemailer": "9.1.1",
    "pngjs": "7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.13",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/nodemailer": "8.0.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
