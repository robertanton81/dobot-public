# Copy to .env.local and fill in the two keys. .env.local is git-ignored.
E2B_API_KEY=
# The E2B cluster. Leave empty for E2B's default cluster. The EU cluster is a separate E2B project
# with its own API key and its own domain, enabled by E2B support on the Pro tier. To switch, put
# the EU key in E2B_API_KEY and the EU domain here. Sandboxes never move between clusters, so set
# sandboxId to null in every bot folder afterwards (docs/operating-guide.md, "Rebuilding the bot's computer by hand").
E2B_DOMAIN=
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-5
TZ=Europe/Prague
PORT=3000

# The bot's mailbox, watched over IMAP so a routine can start when mail arrives instead of
# polling on a schedule. Optional: leave empty and routines waiting for the mail event never fire.
# The watcher only asks how many unseen messages the inbox holds. The bot reads its mail through
# the mailbox connector (see MAILBOX_BOT_ID below) or on its own screen with a sign-in by takeover;
# either way no password reaches the model or the chat.
MAILBOX_HOST=
MAILBOX_PORT=993
MAILBOX_USER=
MAILBOX_PASSWORD=
MAILBOX_POLL_MS=60000

# The notice mail. When a bot needs you on its screen (an approval, a question, a takeover, a run
# that ended blocked, a job refused because you still hold the screen), the platform mails this
# address from the bot's mailbox above, with fixed text and no link. Optional: leave NOTIFY_EMAIL
# empty and nobody is mailed. It must not be the bot's own address. MAILBOX_SMTP_HOST is the
# outgoing (SMTP) server of the same mailbox; the port defaults to 465. The notice is sent from
# MAILBOX_USER, so with NOTIFY_EMAIL set that value must be the full address (name@example.com),
# not a bare login name.
NOTIFY_EMAIL=
MAILBOX_SMTP_HOST=
MAILBOX_SMTP_PORT=

# Connectors: tools a bot uses instead of its computer. Optional.
# MAPY_API_KEY: road distances and place coordinates without the browser (free tier at
# developer.mapy.com). Without it the map connector is not offered.
# MAILBOX_BOT_ID: the one bot (its id, e.g. hunter-1a2b) that may read and send mail from the
# mailbox above through the platform. Without it no bot is offered the mailbox connector.
MAPY_API_KEY=
MAILBOX_BOT_ID=

# Operator limits, defaults shown. Operator setup, not something a user sets in chat.
ROUTINE_MIN_INTERVAL_MINUTES=15
DAILY_BUDGET_USD=25
BLOCKED_HOLD_MINUTES=30
